# Server Configuration
HOST=0.0.0.0
PORT=8880
WORKERS=1
LOG_LEVEL=INFO

# Kokoro Configuration
DEFAULT_VOICE=af_bella
DEFAULT_LANG=a  # 'a' for American English
DEFAULT_SPEED=1.0
DEFAULT_FORMAT=mp3

# Audio Settings
SAMPLE_RATE=24000
MAX_TEXT_LENGTH=10000

# Performance
ENABLE_STREAMING=true
CHUNK_SIZE=1024
CACHE_ENABLED=false

# Paths
MODELS_DIR=./models
OUTPUT_DIR=./output
TEMP_DIR=./temp
